{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "mc-console",
    "name": "Minecraft Console",
    "version": "1.0.1",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "description": "Command suggestions, syntax hints and Tab completion in the server console.",
    "author": "Anton van Zanten",
    "provider": "McConsole\\McConsoleProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "mccon"
    },
    "icon": "terminal",
    "autoload": {
        "McConsole\\": "src"
    }
}
