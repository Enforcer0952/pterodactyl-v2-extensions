        {
            "key": "AutoResetGuildTimeNoOnlinePlayers",
            "group": "guild",
            "type": "float",
            "default": "72.000000",
            "label": "Hours before a guild resets",
            "help": "Hours without a login before the guild is reset. Only used when resetting is on.",
            "min": 0,
            "env": "AUTO_RESET_GUILD_TIME_NO_ONLINE_PLAYERS"
        },
        {
            "key": "GuildRejoinCooldownMinutes",
            "group": "guild",
            "type": "int",
            "default": "0",
            "label": "Guild rejoin cooldown",
            "help": "Minutes before a player can rejoin a guild.",
            "min": 0
        },
        {
            "key": "bInvisibleOtherGuildBaseCampAreaFX",
            "group": "guild",
            "type": "bool",
            "default": "False",
            "label": "Hide other base borders",
            "help": "Hide the boundary of bases from other guilds.",
            "env": "INVISIBLE_OTHER_GUILD_BASE"
        },
        {
            "key": "bEnableDefenseOtherGuildPlayer",
            "group": "guild",
            "type": "bool",
            "default": "False",
            "label": "Defend against other guilds",
