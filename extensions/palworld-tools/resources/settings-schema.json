            "env": "BUILD_AREA_LIMIT"
        },
        {
            "key": "bAutoResetGuildNoOnlinePlayers",
            "group": "guild",
            "type": "bool",
            "default": "False",
            "label": "Reset inactive guilds",
            "help": "Delete the structures and base Pals of a guild when nobody logs in.",
