{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "mc-players",
    "name": "Minecraft Players",
    "version": "1.2.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.4",
        "php": "^8.3"
    },
    "description": "Online players, whitelist, bans and operators on the console page of Minecraft Java servers, with kick, ban, unban, whitelist and op actions.",
    "author": "Anton van Zanten",
    "provider": "McPlayers\\McPlayersProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "mcp"
    },
    "icon": "users",
    "autoload": {
        "McPlayers\\": "src"
    }
}
